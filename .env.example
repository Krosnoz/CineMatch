# Copie ce fichier en .env, puis colle ton jeton TMDB après le =, sans espace ni guillemets.
# .env reste sur ton poste : il est dans .gitignore. Ne le pousse jamais.
TMDB_TOKEN=

# Sur ton poste, laisse ces deux lignes vides : la base est le fichier server/cinematch.db.
# En ligne, Vercel les remplit pour toi quand tu relies la base Turso au projet.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
